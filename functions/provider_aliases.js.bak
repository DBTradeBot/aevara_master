// provider_aliases.js
// Canonical provider aliases + metric mapping + quality (precedence) orders

export const PROVIDER_ALIASES = {
  apple: ["apple", "apple_health", "healthkit", "applehealth", "ahk"],
  googlefit: ["googlefit", "google_fit", "google", "fit"],
  fitbit: ["fitbit", "fb"],
  garmin: ["garmin", "connect", "grmn"],
  whoop: ["whoop"],
  oura: ["oura", "oura_ring", "ouraring"],
};

export const ALL_PROVIDERS = Object.keys(PROVIDER_ALIASES);

// Normalize provider name into canonical id
export function normalizeProviderName(p) {
  if (!p) return null;
  const s = String(p).toLowerCase().trim();
  for (const [canon, list] of Object.entries(PROVIDER_ALIASES)) {
    if (canon === s) return canon;
    if (list.includes(s)) return canon;
  }
  return s; // unknown providers pass through
}

// Back-compat: some call sites import { canonicalProvider }
export const canonicalProvider = normalizeProviderName;

// Canonical metric names (our day doc keys) → possible vendor field aliases
// (Only used when peeking into vendor day docs that haven’t been normalized)
export const METRIC_ALIASES = {
  steps_count: ["steps", "step_count", "daily_steps", "step"],

  // Sleep: include minutes forms so we can convert → hours
  sleep_total_hours: [
    "sleep_hours",
    "sleep_duration_hours",
    "total_sleep_hours",
    "sleep_duration_min",   // minutes → convert
    "sleep_minutes"         // minutes → convert
  ],
  sleep_regularity_pct: ["sleep_regularity", "sleep_regularity_pct", "regularity_pct"],

  // HRV
  hrv_rmssd_ms: ["hrv_rmssd_ms", "rmssd", "hrv", "hrv_rmssd"],
  // Note: Apple often exposes SDNN; treat separately upstream
  hrv_sdnn_ms: ["sdnn", "hrv_sdnn_ms"],

  rhr_bpm: ["resting_hr", "resting_bpm", "resting_heart_rate"],

  vo2max_ml_kg_min: ["vo2max", "max_vo2", "vo2_ml_kg_min"],
  fitness_age_years: ["fitness_age", "garmin_fitness_age", "fitbit_fitness_age"],

  // Calories / energy (Apple/Google variants included)
  calories_out: [
    "calories",
    "calories_out",
    "calories_burned",
    "active_energy_burned",
    "energy_burned",
    "active_kcal",
    "kcal",
    "kilocalories",
    "cal_active",
    "activity_calories"
  ],

  // Activity minutes
  minutes_very_active: ["minutes_very_active", "vigorous_minutes", "high_intensity_minutes"],
  minutes_fairly_active: ["minutes_fairly_active", "moderate_minutes"],
  minutes_lightly_active: ["minutes_lightly_active", "light_minutes"],
  minutes_sedentary: ["minutes_sedentary", "sedentary_minutes"],

  // Distance: allow meters/miles; convert in reader
  distance_km: [
    "distance_km",
    "distance",
    "km",
    "kilometers",
    "distance_m",      // meters → convert
    "meters",
    "metres",
    "m",
    "distance_miles",  // miles → convert
    "miles",
    "mi"
  ],
};

// Back-compat aliases so older imports keep working
export const METRIC_NAME_ALIASES = METRIC_ALIASES;

// Provider quality (precedence) per canonical metric
// First entry has highest priority when multiple providers have values.
export const PROVIDER_QUALITY = {
  // HRV (prefer rMSSD from night/sleep windows)
  hrv_rmssd_ms: ["oura", "whoop", "fitbit", "garmin", "apple", "googlefit"],
  // RHR nightly lowest (WHOOP/Oura), then vendor “resting”
  rhr_bpm: ["whoop", "oura", "fitbit", "garmin", "apple", "googlefit"],
  // Sleep duration / main episode
  sleep_total_hours: ["oura", "whoop", "fitbit", "garmin", "apple", "googlefit"],
  sleep_regularity_pct: ["oura", "whoop", "fitbit", "garmin", "apple", "googlefit"],
  // Steps (avoid double counting phone+watch: pick a single primary)
  steps_count: ["garmin", "fitbit", "apple", "googlefit", "whoop", "oura"],
  // CRF
  vo2max_ml_kg_min: ["apple", "garmin", "fitbit"],
  fitness_age_years: ["garmin", "fitbit"],
  // Secondary drivers
  calories_out: ["garmin", "fitbit", "apple", "googlefit", "whoop", "oura"],
  distance_km: ["garmin", "fitbit", "apple", "googlefit", "whoop", "oura"],
};

// Utility: check if a number is effectively zero (for partial-day guards)
export function isEffectivelyZero(v) {
  if (v == null) return false;
  const n = Number(v);
  if (!Number.isFinite(n)) return false;
  return Math.abs(n) < 1e-9;
}

// Try to extract a canonical metric from an arbitrary vendor doc using aliases.
// Returns { value, fieldUsed } or { value: null, fieldUsed: null }
export function readMetricWithAliases(doc, canonicalKey) {
  if (!doc) return { value: null, fieldUsed: null };

  // 1) direct hit
  if (doc[canonicalKey] != null) return { value: doc[canonicalKey], fieldUsed: canonicalKey };

  // 2) alias scan
  const aliases = METRIC_ALIASES[canonicalKey] || [];
  for (const alt of aliases) {
    if (doc[alt] == null) continue;

    // ---- Special conversions by canonical metric ----
    // Sleep minutes → hours
    if (canonicalKey === "sleep_total_hours" && /min|minutes?/i.test(alt)) {
      const h = Number(doc[alt]) / 60;
      return { value: Number.isFinite(h) ? h : null, fieldUsed: alt };
    }

    // Distance: miles → km
    if (canonicalKey === "distance_km" && /(^mi$|miles?)/i.test(alt)) {
      const km = Number(doc[alt]) * 1.60934;
      return { value: Number.isFinite(km) ? km : null, fieldUsed: alt };
    }

    // Distance: meters → km
    if (canonicalKey === "distance_km" && /(meters?|metres?|^m$|distance_m)/i.test(alt)) {
      const km = Number(doc[alt]) / 1000;
      return { value: Number.isFinite(km) ? km : null, fieldUsed: alt };
    }

    // Calories: ensure numeric
    if (canonicalKey === "calories_out") {
      const val = Number(doc[alt]);
      return { value: Number.isFinite(val) ? val : null, fieldUsed: alt };
    }

    // Default passthrough
    return { value: doc[alt], fieldUsed: alt };
  }

  return { value: null, fieldUsed: null };
}

/**
 * Back-compat helper:
 * For older call sites that expect a scalar, return just the value.
 * Prefer readMetricWithAliases() in new code.
 */
export function pickByAliases(doc, canonicalKey) {
  return readMetricWithAliases(doc, canonicalKey).value;
}

