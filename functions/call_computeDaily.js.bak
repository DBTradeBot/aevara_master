/**
 * Thin callable/HTTP wrappers for computeDaily (ESM-safe)
 * Node 20 / ESM / Firebase Functions v2
 *
 * Exposes:
 *   • callComputeDaily (callable) — uses auth.uid
 *   • computeDailyProxy (HTTP POST) — admin/server-to-server
 *
 * Behavior:
 *   • Proxies to already-deployed computeDailyHttp via internal HTTPS
 *   • No CommonJS; pure ESM
 */

import { onCall, onRequest } from "firebase-functions/v2/https";
import * as logger from "firebase-functions/logger";
import { getApps, initializeApp, applicationDefault } from "firebase-admin/app";

// Admin SDK init (ESM-safe, idempotent)
if (!getApps().length) {
  initializeApp({ credential: applicationDefault() });
}

// Env & config
const REGION = "us-central1";
const PROJECT =
  process.env.GCLOUD_PROJECT ||
  process.env.GCP_PROJECT ||
  (process.env.FIREBASE_CONFIG
    ? (() => {
        try {
          return JSON.parse(process.env.FIREBASE_CONFIG)?.projectId || "";
        } catch {
          return "";
        }
      })()
    : "") ||
  "";

const SYNC_SECRET = process.env.FITBIT_SYNC_SECRET || null;
// Optional local override: LOCAL_COMPUTE_URL="http://127.0.0.1:5001/<proj>/<region>/computeDailyHttp"
const LOCAL_COMPUTE_URL = process.env.LOCAL_COMPUTE_URL || "";

function internalComputeUrl() {
  if (LOCAL_COMPUTE_URL) return LOCAL_COMPUTE_URL;
  if (!PROJECT) {
    logger.warn(
      "PROJECT env empty; internal URL may be malformed outside GCP. Set LOCAL_COMPUTE_URL for local tests."
    );
  }
  // Gen2 HTTPS function proxy still resolves at cloudfunctions.net
  return `https://${REGION}-${PROJECT}.cloudfunctions.net/computeDailyHttp`;
}

/** POST helper to computeDailyHttp */
async function postCompute({ userId, date_local, tz }) {
  const url = internalComputeUrl();
  const headers = { "Content-Type": "application/json" };
  if (SYNC_SECRET) headers["x-sync-secret"] = SYNC_SECRET;

  const body = JSON.stringify({
    userId: userId || undefined,
    date_local: date_local || undefined,
    tz: tz || undefined,
  });

  const resp = await fetch(url, { method: "POST", headers, body });

  const text = await resp.text();
  let json;
  try {
    json = text ? JSON.parse(text) : null;
  } catch {
    json = { ok: false, error: "invalid_json", raw: text };
  }

  if (!resp.ok) {
    const msg = (json && json.error) || `${resp.status} ${resp.statusText}`;
    throw new Error(`computeDailyHttp failed: ${msg}`);
  }
  return json || { ok: true };
}

// Callable: uses auth.uid; data: { date_local?: 'YYYY-MM-DD', tz?: string }
export const callComputeDaily = onCall({ region: REGION }, async (req) => {
  const uid = req.auth?.uid;
  if (!uid) return { ok: false, code: "unauthenticated" };

  const date_local =
    typeof req.data?.date_local === "string" ? req.data.date_local : undefined;
  const tz = typeof req.data?.tz === "string" ? req.data.tz : undefined;

  try {
    const out = await postCompute({ userId: uid, date_local, tz });
    return { ok: true, ...out };
  } catch (e) {
    logger.error("callComputeDaily error", {
      uid,
      message: e?.message || String(e),
    });
    return { ok: false, code: "compute_failed", error: String(e?.message || e) };
  }
});

// HTTP proxy (admin/server-to-server): POST { uid, date_local?, tz? }
export const computeDailyProxy = onRequest(
  { region: REGION, cors: true },
  async (req, res) => {
    try {
      if (req.method !== "POST") {
        return res.status(405).json({ ok: false, error: "Use POST" });
      }
      const uid = String(req.body?.uid || "");
      if (!uid) return res.status(400).json({ ok: false, error: "Missing uid" });

      const date_local =
        typeof req.body?.date_local === "string" ? req.body.date_local : undefined;
      const tz = typeof req.body?.tz === "string" ? req.body.tz : undefined;

      const out = await postCompute({ userId: uid, date_local, tz });
      return res.status(200).json({ ok: true, ...out });
    } catch (e) {
      logger.error("computeDailyProxy error", { message: e?.message || String(e) });
      return res.status(500).json({ ok: false, error: String(e?.message || e) });
    }
  }
);
