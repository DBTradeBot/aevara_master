// functions/ddc/finalize.js
// Finalize a day under DDC: mark as 'final' at 03:00 local on D+1
// Node 20 / ESM

import { onSchedule } from "firebase-functions/v2/scheduler";
import { onCall } from "firebase-functions/v2/https";
import * as logger from "firebase-functions/logger";
import { getFirestore, FieldValue } from "firebase-admin/firestore";
import { isDateKey, dateKeyInTZ, parseDateKey } from "../core/ddc_utils.js";

const db = getFirestore();

/**
 * finalizeDailyDDCForUserDay(uid, dateKey, { tz, force })
 *  - When now_local >= (D+1 @ 03:00), mark display.status = 'final' and set finalized_at_utc.
 *  - No-op if already final unless force=true.
 */
export async function finalizeDailyDDCForUserDay(
  uid,
  dateKey,
  { tz = "America/Los_Angeles", force = false } = {}
) {
  if (!uid) throw new Error("finalizeDailyDDC: missing uid");
  if (!isDateKey(dateKey)) throw new Error("finalizeDailyDDC: invalid dateKey");

  const ref = db.doc(`users/${uid}/days/${dateKey}`);
  const snap = await ref.get();
  const d = snap.exists ? snap.data() || {} : {};

  if (!force && d?.display?.status === "final") {
    return { ok: true, no_op: true, reason: "already_final" };
  }

  if (!force) {
    const due = isFinalizeDue(dateKey, tz);
    if (!due) return { ok: true, no_op: true, reason: "not_due" };
  }

  await ref.set(
    {
      display: { ...(d.display || {}), status: "final" },
      finalized_at_utc: FieldValue.serverTimestamp(),
      recompute_log: FieldValue.arrayUnion({
        at_utc: new Date().toISOString(),
        reason: force ? "finalize_force" : "finalize_due",
      }),
    },
    { merge: true }
  );

  return { ok: true, finalized: true };
}

/* ------------------------------ helpers ------------------------------ */

/**
 * isFinalizeDue(dateKey, tz)
 * Final due when local time is at/after 03:00 on D+1.
 */
export function isFinalizeDue(dateKey, tz) {
  const now = new Date();
  const nowLocalKey = dateKeyInTZ(now, tz);

  const d = parseDateKey(dateKey); // UTC date for D
  if (!d) return false;
  d.setUTCDate(d.getUTCDate() + 1); // D+1 (as a date object)
  const dPlus1LocalKey = dateKeyInTZ(d, tz);

  if (nowLocalKey > dPlus1LocalKey) return true;
  if (nowLocalKey < dPlus1LocalKey) return false;

  // same local day as D+1; check local hour
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: tz,
    hour: "numeric",
    hour12: false,
  })
    .formatToParts(now)
    .reduce((acc, p) => ((acc[p.type] = p.value), acc), {});
  const hourLocal = Number(parts.hour || 0);
  return hourLocal >= 3;
}

/* --------------------- Scheduled + Callable entrypoints -------------------- */

/**
 * Scheduled builder (keeps the legacy name/type: finalizeDailyDDC).
 * NOTE: This skeleton processes a narrow window (yesterday & the day before)
 * by looking for non-final days using a common field `date_local` if present.
 * Adjust to your exact schema if `date_local` differs.
 */
export const finalizeDailyDDC = onSchedule(
  {
    region: "us-central1",
    schedule: "every day 03:00",
    timeZone: "America/Los_Angeles",
  },
  async () => {
    // We’ll conservatively sweep two recent dates to keep the job light.
    const now = new Date();
    const laTz = "America/Los_Angeles";

    const keys = [];
    for (let i = 1; i <= 2; i++) {
      const d = new Date(now);
      d.setDate(d.getDate() - i);
      keys.push(dateKeyInTZ(d, laTz));
    }

    // If your day docs store `date_local`, we can query by that.
    // Fallback: if you don't have date_local, replace this with your own indexing scheme.
    let touched = 0;
    for (const key of keys) {
      const cg = await db
        .collectionGroup("days")
        .where("date_local", "==", key)
        .get();

      const batch = db.batch();
      cg.forEach((doc) => {
        const data = doc.data() || {};
        const display = data.display || {};
        if (display.status === "final") return;

        batch.set(
          doc.ref,
          {
            display: { ...display, status: "final" },
            finalized_at_utc: FieldValue.serverTimestamp(),
            recompute_log: FieldValue.arrayUnion({
              at_utc: new Date().toISOString(),
              reason: "finalize_due_scheduled",
            }),
          },
          { merge: true }
        );
        touched++;
      });

      if (touched) await batch.commit();
    }

    logger.info("[ddc] finalizeDailyDDC sweep complete", { daysTouched: touched });
    return { ok: true, daysTouched: touched };
  }
);

/**
 * Manual helper (different name to avoid conflicts with the scheduled entrypoint).
 * Call with: { uid, dateKey, tz?, force? }
 */
export const finalizeDailyDDCCall = onCall(async (req) => {
  const uid = String(req.data?.uid || "").trim();
  const dateKey = String(req.data?.dateKey || "").trim();
  const tz = String(req.data?.tz || "America/Los_Angeles");
  const force = !!req.data?.force;
  if (!uid || !isDateKey(dateKey)) throw new Error("missing uid or invalid dateKey");
  return finalizeDailyDDCForUserDay(uid, dateKey, { tz, force });
});
